APP_NAME=Mailroute
# Development: set APP_ENV=local and APP_DEBUG=true. Never run a public instance with those.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mailroute
DB_USERNAME=mailroute
DB_PASSWORD=
# Tests run in this schema of the same database (see phpunit.xml)
# DB_SEARCH_PATH=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true when the site is served over HTTPS
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Requests per minute per API key on the email API
MAILROUTE_API_RATE_LIMIT=600

# Shared hosting: run the queue worker from cron (schedule:run) instead of supervisor/systemd
MAILROUTE_QUEUE_VIA_SCHEDULER=false

# Needed as ?setup=<token> to create the first admin from /login (any environment, except a direct visit from this machine when APP_ENV=local)
MAILROUTE_SETUP_TOKEN=

# Dashboard sign-in lockout
MAILROUTE_LOGIN_MAX_ATTEMPTS=5
MAILROUTE_LOGIN_LOCKOUT_MINUTES=30

# Emergency switch: ignore the sign-in reCAPTCHA setting
MAILROUTE_CAPTCHA_DISABLED=false

# Attachment URLs (attachments[].path) may only point at public hosts on ports 80/443.
# Set to true only if you must fetch from private/internal addresses.
MAILROUTE_ALLOW_PRIVATE_ATTACHMENT_URLS=false
